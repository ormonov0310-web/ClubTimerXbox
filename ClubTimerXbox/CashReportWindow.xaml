<Window x:Class="ClubTimerXbox.CashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Касса"
        Width="980"
        Height="720"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#10141C"
        ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Касса"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <Button Content="Закрыть"
                    Width="110"
                    Height="38"
                    FontSize="15"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="CloseButton_Click"/>
        </DockPanel>

        <!-- Итоговая карточка -->
        <Border Grid.Row="1"
                Background="#18202B"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SummaryTitleText"
                               Text="Итог"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SummaryCountText"
                               Text="Записей: 0"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Общая"
                               Foreground="#94A3B8"
                               FontSize="13"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SummaryTotalText"
                               Text="0 сом"
                               Foreground="#4ADE80"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="Наличные"
                               Foreground="#94A3B8"
                               FontSize="13"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SummaryCashText"
                               Text="0 сом"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                    <TextBlock Text="М Банк"
                               Foreground="#94A3B8"
                               FontSize="13"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SummaryMBankText"
                               Text="0 сом"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Разделы -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Раздел"
                       Foreground="#CBD5E1"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="GamesSectionButton"
                        Content="Игры"
                        Width="130"
                        Height="38"
                        Margin="0,0,8,0"
                        Click="GamesSectionButton_Click"/>

                <Button x:Name="ProductsSectionButton"
                        Content="Товары/услуги"
                        Width="150"
                        Height="38"
                        Margin="0,0,8,0"
                        Click="ProductsSectionButton_Click"/>

                <Button x:Name="EmployeesSectionButton"
                        Content="Работники"
                        Width="130"
                        Height="38"
                        Margin="0,0,8,0"
                        Click="EmployeesSectionButton_Click"/>

                <Button x:Name="ExpensesSectionButton"
                        Content="Расходы"
                        Width="130"
                        Height="38"
                        Click="ExpensesSectionButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Период и вид -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Период"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DayPeriodButton"
                            Content="День"
                            Width="160"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="DayPeriodButton_Click"/>

                    <Button x:Name="MonthPeriodButton"
                            Content="Месяц"
                            Width="170"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="MonthPeriodButton_Click"/>

                    <Button x:Name="CustomPeriodButton"
                            Content="Период"
                            Width="220"
                            Height="38"
                            Click="CustomPeriodButton_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Показать как"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <StackPanel x:Name="ViewButtonsPanel" Orientation="Horizontal">
                    <Button x:Name="RecordsViewButton"
                            Content="Записи"
                            Width="110"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="RecordsViewButton_Click"/>

                    <Button x:Name="DaysViewButton"
                            Content="Дни"
                            Width="100"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="DaysViewButton_Click"/>

                    <Button x:Name="MainGroupViewButton"
                            Content="ТВ/Рули"
                            Width="120"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="MainGroupViewButton_Click"/>

                    <Button x:Name="EmployeesViewButton"
                            Content="Сотрудники"
                            Width="130"
                            Height="38"
                            Click="EmployeesViewButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Прокручиваемый список -->
        <Border Grid.Row="4"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Нижняя строка -->
        <TextBlock Grid.Row="5"
                   x:Name="BottomInfoText"
                   Text="Записей: 0"
                   Foreground="#94A3B8"
                   FontSize="13"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>