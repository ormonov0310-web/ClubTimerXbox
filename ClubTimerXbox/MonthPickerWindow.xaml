<Window x:Class="ClubTimerXbox.MonthPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор месяца"
        Width="420"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#10141C"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <StackPanel>
            <TextBlock Text="Выберите месяц"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Год"
                       Foreground="#CBD5E1"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="YearTextBox"
                     Height="42"
                     FontSize="18"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Месяц"
                       Foreground="#CBD5E1"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="MonthComboBox"
                      Height="42"
                      FontSize="17"
                      Margin="0,0,0,18">
                <ComboBoxItem Content="Январь" Tag="1"/>
                <ComboBoxItem Content="Февраль" Tag="2"/>
                <ComboBoxItem Content="Март" Tag="3"/>
                <ComboBoxItem Content="Апрель" Tag="4"/>
                <ComboBoxItem Content="Май" Tag="5"/>
                <ComboBoxItem Content="Июнь" Tag="6"/>
                <ComboBoxItem Content="Июль" Tag="7"/>
                <ComboBoxItem Content="Август" Tag="8"/>
                <ComboBoxItem Content="Сентябрь" Tag="9"/>
                <ComboBoxItem Content="Октябрь" Tag="10"/>
                <ComboBoxItem Content="Ноябрь" Tag="11"/>
                <ComboBoxItem Content="Декабрь" Tag="12"/>
            </ComboBox>

            <Button Content="Применить"
                    Height="46"
                    FontSize="17"
                    FontWeight="Bold"
                    Background="#16A34A"
                    Foreground="White"
                    Click="ApplyButton_Click"
                    Margin="0,0,0,10"/>

            <Button Content="Отмена"
                    Height="42"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#334155"
                    Foreground="White"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>