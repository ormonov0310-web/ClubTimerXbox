<Window x:Class="ClubTimerXbox.PeriodPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор периода"
        Width="620"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="#10141C"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <StackPanel>
            <TextBlock Text="Выберите период"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата начала"
                               Foreground="#CBD5E1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <Calendar x:Name="StartCalendar"
                              Height="260"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Дата конца"
                               Foreground="#CBD5E1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <Calendar x:Name="EndCalendar"
                              Height="260"/>
                </StackPanel>
            </Grid>

            <Button Content="Применить"
                    Height="46"
                    FontSize="17"
                    FontWeight="Bold"
                    Background="#16A34A"
                    Foreground="White"
                    Click="ApplyButton_Click"
                    Margin="0,0,0,10"/>

            <Button Content="Отмена"
                    Height="42"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#334155"
                    Foreground="White"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>