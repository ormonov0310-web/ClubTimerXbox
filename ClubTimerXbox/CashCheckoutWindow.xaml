<Window x:Class="ClubTimerXbox.CashCheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Касса / ККМ"
        Width="520"
        Height="680"
        MinWidth="480"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#10141C"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <StackPanel>
                <TextBlock Text="Касса / ККМ"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>

                <Border Background="#18202B"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="EmployeeText"
                                   Foreground="#CBD5E1"
                                   FontSize="16"
                                   Margin="0,0,0,6"/>

                        <TextBlock x:Name="OperationText"
                                   Foreground="#CBD5E1"
                                   FontSize="16"
                                   Margin="0,0,0,6"/>

                        <TextBlock x:Name="PlaceText"
                                   Foreground="#94A3B8"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>

                <Border Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Позиции"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <StackPanel x:Name="ItemsPanel"/>
                    </StackPanel>
                </Border>

                <Border Background="#18202B"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="TotalText"
                                   Text="Итого: 0 сом"
                                   Foreground="#4ADE80"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    x:Name="FullCashButton"
                                    Height="56"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Background="#16A34A"
                                    BorderBrush="#16A34A"
                                    BorderThickness="2"
                                    Foreground="White"
                                    Click="FullCashButton_Click"/>

                            <Button Grid.Column="2"
                                    x:Name="FullMBankButton"
                                    Height="56"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Background="#2563EB"
                                    BorderBrush="#2563EB"
                                    BorderThickness="2"
                                    Foreground="White"
                                    Click="FullMBankButton_Click"/>
                        </Grid>

                        <TextBlock Text="Быстрая оплата целиком"
                                   Foreground="#94A3B8"
                                   FontSize="13"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PartialPaymentCard"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Частичная оплата"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="PaymentModeText"
                                   Text="Быстрый режим выбран выше."
                                   Foreground="#94A3B8"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Наличные"
                                   Foreground="#CBD5E1"
                                   FontSize="14"/>

                        <TextBox x:Name="CashTextBox"
                                 Height="42"
                                 FontSize="18"
                                 Margin="0,6,0,12"
                                 GotKeyboardFocus="AmountTextBox_GotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="AmountTextBox_PreviewMouseLeftButtonDown"
                                 PreviewTextInput="AmountTextBox_PreviewTextInput"
                                 TextChanged="CashTextBox_TextChanged"/>

                        <TextBlock Text="М Банк"
                                   Foreground="#CBD5E1"
                                   FontSize="14"/>

                        <TextBox x:Name="MBankTextBox"
                                 Height="42"
                                 FontSize="18"
                                 Margin="0,6,0,10"
                                 GotKeyboardFocus="AmountTextBox_GotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="AmountTextBox_PreviewMouseLeftButtonDown"
                                 PreviewTextInput="AmountTextBox_PreviewTextInput"
                                 TextChanged="MBankTextBox_TextChanged"/>

                        <TextBlock x:Name="PaymentCheckText"
                                   Foreground="#FBBF24"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Content="Подтвердить оплату"
                        Height="52"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#16A34A"
                        Foreground="White"
                        Click="ConfirmButton_Click"
                        Margin="0,0,0,10"/>

                <Button x:Name="TransferToPlaceButton"
                        Content="Оформить на другой ТВ"
                        Height="48"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#F59E0B"
                        Foreground="White"
                        Click="TransferToPlaceButton_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Отмена"
                        Height="46"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#334155"
                        Foreground="White"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
