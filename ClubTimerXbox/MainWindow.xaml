<Window x:Class="ClubTimerXbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Club Timer Xbox"
        Icon="Assets/AppIcon/clubtimer.ico"
        Height="720"
        Width="1180"
        MinWidth="1120"
        MinHeight="927"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBrush}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ButtonHoverBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.035"
                                             Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.035"
                                             Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Background="{DynamicResource Theme.HeaderBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Club Timer Xbox"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="BusinessCalendarText"
                               Foreground="#E2E8F0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="NewBranchPromoTimerText"
                               Foreground="#4ADE80"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>

                    <TextBlock Text="Игровой клуб • ТВ • Рули"
                               Foreground="#AAB4C3"
                               FontSize="15"
                               Margin="0,4,0,0"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button x:Name="CurrentEmployeeButton"
                                Content="Смена: не выбрана"
                                Width="220"
                                Height="34"
                                FontSize="15"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"
                                Click="CurrentEmployeeButton_Click"/>

                        <Button x:Name="PlacesViewButton"
                                Content="ТВ / Рули"
                                Width="110"
                                Height="34"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="PlacesViewButton_Click"
                                PreviewMouseRightButtonUp="PlacesViewButton_PreviewMouseRightButtonUp"/>

                        <Button x:Name="TuyaViewButton"
                                Content="WiFi - Розетки"
                                Width="140"
                                Height="34"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Click="TuyaViewButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">

                        <Button x:Name="SaleButton"
                                Content="+ Товар / услуга"
                                Width="160"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="AddSaleButton_Click"/>

                        <Button x:Name="StockAuditButton"
                                Content="Приёмка"
                                Width="110"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="StockAuditButton_Click"/>

                        <Button x:Name="ActionLogButton"
                                Content="Журнал"
                                Width="110"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="ActionLogButton_Click"/>

                        <Button x:Name="SettingsButton"
                                Content="⚙ Настройки"
                                Width="140"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Click="SettingsButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="MainCashText"
                               Text="Касса: 0 сом"
                               Foreground="#4ADE80"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Cursor="Hand"
                               PreviewMouseLeftButtonDown="OpenCashReportFromMainText_MouseLeftButtonUp"/>

                    <TextBlock Text="Правая кнопка мыши по месту — открыть меню"
                               Foreground="#AAB4C3"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- Классический экран и список розеток используют прежний контейнер. -->
            <ScrollViewer x:Name="ClassicPlacesScrollViewer">
                <ItemsControl x:Name="PlacesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="AlternativePlacesGrid"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="610"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource Theme.HeaderBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="4,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="План клуба"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="FloorPlanEditorStatusText"
                                           Text="Схема защищена от случайного перемещения"
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button x:Name="FloorPlanResetButton"
                                    Grid.Column="1"
                                    Content="↺"
                                    Width="38"
                                    Height="36"
                                    FontSize="20"
                                    Visibility="Collapsed"
                                    ToolTip="Сбросить расстановку"
                                    Click="FloorPlanResetButton_Click"/>

                            <Button x:Name="FloorPlanEditorButton"
                                    Grid.Column="3"
                                    Content="Редактор"
                                    MinWidth="112"
                                    Height="36"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="FloorPlanEditorButton_Click"/>
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Canvas x:Name="FloorPlanCanvas"
                                    MinHeight="500"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="FloorPlanCanvas_MouseLeftButtonDown"
                                    SizeChanged="FloorPlanCanvas_SizeChanged">
                                <Canvas.Background>
                                    <DrawingBrush TileMode="Tile"
                                                  Viewport="0,0,32,32"
                                                  ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#18101B2A">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#30475F7B" Thickness="1"/>
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="0,0" EndPoint="32,0"/>
                                                        <LineGeometry StartPoint="0,0" EndPoint="0,32"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Canvas.Background>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="AlternativeDetailsCard"
                        Grid.Column="2"
                        Background="{DynamicResource Theme.HeaderBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="AlternativeDetailTypeText"
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="AlternativeDetailTitleText"
                                       Text="Выберите место"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="AlternativeDetailStatusText"
                                       Foreground="#4ADE80"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,0"/>
                            <TextBlock x:Name="AlternativeDetailTimeText"
                                       Text="00:00"
                                       Foreground="White"
                                       FontSize="52"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>
                            <Border Height="1"
                                    Background="#334155"
                                    Margin="0,18,0,16"/>
                            <TextBlock x:Name="AlternativeDetailMoneyText"
                                       Foreground="#CBD5E1"
                                       FontSize="16"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AlternativeDetailEmployeeText"
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                            <TextBlock x:Name="AlternativeDetailSalesText"
                                       Foreground="#FBBF24"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
