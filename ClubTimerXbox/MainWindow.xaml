<Window x:Class="ClubTimerXbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Club Timer Xbox"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#10141C">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Background="#18202B"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Club Timer Xbox"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Игровой клуб • ТВ • Рули"
                               Foreground="#AAB4C3"
                               FontSize="15"
                               Margin="0,4,0,0"/>

                    <Button x:Name="CurrentEmployeeButton"
                            Content="Смена: не выбрана"
                            Width="220"
                            Height="34"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="CurrentEmployeeButton_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">

                        <Button x:Name="SaleButton"
                                Content="+ Товар / услуга"
                                Width="160"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="AddSaleButton_Click"/>

                        <Button x:Name="StockAuditButton"
                                Content="Приёмка"
                                Width="110"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="StockAuditButton_Click"/>

                        <Button x:Name="ActionLogButton"
                                Content="Журнал"
                                Width="110"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="ActionLogButton_Click"/>

                        <Button x:Name="SettingsButton"
                                Content="⚙ Настройки"
                                Width="140"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Click="SettingsButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="MainCashText"
                               Text="Касса: 0 сом"
                               Foreground="#4ADE80"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Cursor="Hand"
                               PreviewMouseLeftButtonDown="OpenCashReportFromMainText_MouseLeftButtonUp"/>

                    <TextBlock Text="Правая кнопка мыши по месту — открыть меню"
                               Foreground="#AAB4C3"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Здесь карточки создаются из C# кода -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="PlacesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
