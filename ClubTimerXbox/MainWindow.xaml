<Window x:Class="ClubTimerXbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Club Timer Xbox"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#10141C">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#253044"/>
            <Setter Property="BorderBrush" Value="#344155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#334155"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.035"
                                             Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.035"
                                             Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Background="#18202B"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Club Timer Xbox"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Игровой клуб • ТВ • Рули"
                               Foreground="#AAB4C3"
                               FontSize="15"
                               Margin="0,4,0,0"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button x:Name="CurrentEmployeeButton"
                                Content="Смена: не выбрана"
                                Width="220"
                                Height="34"
                                FontSize="15"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"
                                Click="CurrentEmployeeButton_Click"/>

                        <Button x:Name="PlacesViewButton"
                                Content="ТВ / Рули"
                                Width="110"
                                Height="34"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="PlacesViewButton_Click"/>

                        <Button x:Name="TuyaViewButton"
                                Content="WiFi - Розетки"
                                Width="140"
                                Height="34"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Click="TuyaViewButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">

                        <Button x:Name="SaleButton"
                                Content="+ Товар / услуга"
                                Width="160"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="AddSaleButton_Click"/>

                        <Button x:Name="StockAuditButton"
                                Content="Приёмка"
                                Width="110"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="StockAuditButton_Click"/>

                        <Button x:Name="ActionLogButton"
                                Content="Журнал"
                                Width="110"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                Click="ActionLogButton_Click"/>

                        <Button x:Name="SettingsButton"
                                Content="⚙ Настройки"
                                Width="140"
                                Height="38"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Click="SettingsButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="MainCashText"
                               Text="Касса: 0 сом"
                               Foreground="#4ADE80"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Cursor="Hand"
                               PreviewMouseLeftButtonDown="OpenCashReportFromMainText_MouseLeftButtonUp"/>

                    <TextBlock Text="Правая кнопка мыши по месту — открыть меню"
                               Foreground="#AAB4C3"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Здесь карточки создаются из C# кода -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="PlacesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
