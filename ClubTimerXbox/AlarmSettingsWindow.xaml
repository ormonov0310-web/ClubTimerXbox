<Window x:Class="ClubTimerXbox.AlarmSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Будильник"
        Width="460"
        Height="640"
        MinWidth="430"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#10141C"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <StackPanel>
                <TextBlock Text="Настройки будильника"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,18"/>

                <CheckBox x:Name="AlarmEnabledCheckBox"
                          Content="Включить будильник"
                          Foreground="White"
                          FontSize="16"
                          Margin="0,0,0,18"/>

                <TextBlock Text="Когда сработать:"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           FontWeight="Bold"/>

                <TextBlock Text="За сколько секунд до окончания предоплаченного времени показать предупреждение."
                           Foreground="#94A3B8"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,4,0,6"/>

                <ComboBox x:Name="TriggerSecondsComboBox"
                          FontSize="16"
                          Margin="0,6,0,18"
                          Height="40">
                    <ComboBoxItem Content="30 секунд" Tag="30"/>
                    <ComboBoxItem Content="1 минута" Tag="60"/>
                    <ComboBoxItem Content="2 минуты" Tag="120"/>
                    <ComboBoxItem Content="5 минут" Tag="300"/>
                </ComboBox>

                <TextBlock Text="Звук:"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           FontWeight="Bold"/>

                <ComboBox x:Name="SoundComboBox"
                          FontSize="16"
                          Margin="0,6,0,18"
                          Height="40">
                    <ComboBoxItem Content="Будильник" Tag="Exclamation"/>
                    <ComboBoxItem Content="Тревога" Tag="Hand"/>
                    <ComboBoxItem Content="Короткий" Tag="Beep"/>
                    <ComboBoxItem Content="Мягкий" Tag="Asterisk"/>
                </ComboBox>

                <TextBlock Text="Сколько играть звук:"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           FontWeight="Bold"/>

                <TextBlock Text="Если выбрать “Пока не нажмут OK”, звук будет повторяться до подтверждения или до окончания времени."
                           Foreground="#94A3B8"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,4,0,6"/>

                <ComboBox x:Name="DurationComboBox"
                          FontSize="16"
                          Margin="0,6,0,22"
                          Height="40">
                    <ComboBoxItem Content="3 секунды" Tag="3"/>
                    <ComboBoxItem Content="5 секунд" Tag="5"/>
                    <ComboBoxItem Content="10 секунд" Tag="10"/>
                    <ComboBoxItem Content="Пока не нажмут OK" Tag="0"/>
                </ComboBox>

                <Button Content="Проверить звук"
                        Height="44"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#475569"
                        Foreground="White"
                        Click="TestSoundButton_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Сохранить"
                        Height="48"
                        FontSize="17"
                        FontWeight="Bold"
                        Background="#16A34A"
                        Foreground="White"
                        Click="SaveButton_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Отмена"
                        Height="44"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#334155"
                        Foreground="White"
                        Click="CancelButton_Click"
                        Margin="0,0,0,12"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>