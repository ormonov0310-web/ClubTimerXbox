<Window x:Class="ClubTimerXbox.WarningAlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скоро время закончится"
        Width="460"
        Height="340"
        WindowStartupLocation="CenterOwner"
        Background="#070A10"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="18">
        <Border x:Name="AlarmBorder"
                Background="#171B26"
                BorderBrush="#FBBF24"
                BorderThickness="1"
                CornerRadius="18"
                Padding="24">
            <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="Скоро время заканчивается"
                       Foreground="#FBBF24"
                       FontSize="26"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <TextBlock x:Name="MessageText"
                       Text="Осталось мало времени"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24"/>

            <Button x:Name="OkButton"
                    Content="Понятно"
                    Height="46"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#2563EB"
                    Foreground="White"
                    Click="OkButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
