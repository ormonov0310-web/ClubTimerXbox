<Window x:Class="ClubTimerXbox.WarningAlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скоро время закончится"
        Width="420"
        Height="260"
        WindowStartupLocation="CenterOwner"
        Background="#10141C"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="18">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="Скоро время заканчивается"
                       Foreground="#FBBF24"
                       FontSize="24"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <TextBlock x:Name="MessageText"
                       Text="Осталось мало времени"
                       Foreground="White"
                       FontSize="18"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,22"/>

            <Button Content="OK"
                    Height="46"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#2563EB"
                    Foreground="White"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>